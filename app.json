{
  "expo": {
    "name": "NasiyaDaftari",
    "slug": "NasiyaDaftari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rbsx.nasiyadaftariapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Mikrofondan foydalanishga ruxsat bering.",
        "NSSpeechRecognitionUsageDescription": "Ovozli matn kiritishga ruxsat bering.",
        "NSContactsUsageDescription": "Mijozni kontaktlardan tez qo'shish uchun kontaktlarga ruxsat bering."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rbsx.nasiyadaftariapp",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Mikrofondan foydalanishga ruxsat bering.",
          "speechRecognitionPermission": "Ovozli matn kiritishga ruxsat bering."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-contacts"
    ],
    "extra": {
      "eas": {
        "projectId": "44e0c769-3f4c-461a-8c4f-5249df3f1b4b"
      }
    }
  }
}
